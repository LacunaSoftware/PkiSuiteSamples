source 'https://rubygems.org'

# Only the Rails frameworks that config/application.rb loads. The 'rails' gem would also
# install Active Record, Active Storage, Action Cable, Action Mailer, Action Mailbox and
# Action Text, which this app does not use.
gem 'actionpack', '~> 8.1.0'
gem 'actionview', '~> 8.1.0'
gem 'activejob', '~> 8.1.0'
gem 'activemodel', '~> 8.1.0'
gem 'railties', '~> 8.1.0'
# Serves the page scripts in app/assets/javascripts and application.css
gem 'sprockets-rails', '>= 3.5'
# Use the Puma web server [https://github.com/puma/puma]
gem 'puma', '>= 6.0'
# Use Active Model has_secure_password
# gem 'bcrypt', '~> 3.1.7'
# PDF generator for Ruby. Read more: https://github.com/prawnpdf/prawn
gem 'prawn', '~> 2.5'

# Reduces boot times through caching; required in config/boot.rb
gem 'bootsnap', require: false

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem 'debug', platforms: %i[mri windows], require: 'debug/prelude'
end

group :development do
  # Access an interactive console on exception pages or by calling 'console' anywhere in the code.
  gem 'web-console'
end

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: %i[windows jruby]

# Lacuna's REST PKI client gem. Published on RubyGems: https://rubygems.org/gems/rest_pki
gem 'rest_pki', '~> 1.1.0'

# Lacuna's PKI Express gem. Published on RubyGems: https://rubygems.org/gems/pki_express
# Versions up to 1.3.2 need config/initializers/pki_express_ruby32_compat.rb on Ruby 3.2+.
gem 'pki_express', '~> 1.3.2'
