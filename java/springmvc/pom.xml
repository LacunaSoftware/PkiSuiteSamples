<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.lacunasoftware</groupId>
	<artifactId>pkisuite</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>sample</name>
	<description>Demo project for Spring Boot</description>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/>
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>21</java.version>
		<!-- Spring Boot 4.0.8 manages versions of these with known vulnerabilities. Remove each
		     override once a Spring Boot release manages a fixed version. The same overrides are in
		     build.gradle. -->
		<tomcat.version>11.0.25</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- cloudhub-client brings okhttp 4.10.0, which brings okio 3.0.0 (known vulnerability) -->
			<dependency>
				<groupId>com.squareup.okio</groupId>
				<artifactId>okio-jvm</artifactId>
				<version>3.4.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>itextpdf</artifactId>
			<version>5.5.13.3</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.pkiexpress</groupId>
			<artifactId>pki-express</artifactId>
			<version>1.23.1</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.restpki</groupId>
			<artifactId>restpki-client</artifactId>
			<version>1.15.11</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.restpki</groupId>
			<artifactId>restpkicore-client</artifactId>
			<version>1.4.0</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.amplia</groupId>
			<artifactId>amplia-client</artifactId>
			<version>1.2.1</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.cloudhub</groupId>
			<artifactId>cloudhub-client</artifactId>
			<version>1.0.5</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.signer</groupId>
			<artifactId>signer-client</artifactId>
			<version>2.14.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.14.0</version>
		</dependency>

		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.11</version>
		</dependency>

		<!-- gson is the JSON mapper of the REST controllers (see application.yml). This starter brings
		     gson and Spring Boot's gson auto-configuration. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-gson</artifactId>
		</dependency>

		<!-- Jackson 2 reads the Rest PKI Core webhook events (WebhookRestCoreController). Spring Boot
		     4's starters bring only Jackson 3. Its version comes from Spring Boot's Jackson 2 BOM. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<excludes>
						<!-- This self-test calls RestPkiService.extendArchivalSignature(), which no
						     released restpkicore-client has yet (it is only on the client's
						     feature/extendachive branch, commit 93e460c). Re-enable it once
						     restpkicore-client ships that method. The same exclusion is in build.gradle. -->
						<exclude>**/XmlDiplomaArchivalExtensionCoreSelfTestController.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
