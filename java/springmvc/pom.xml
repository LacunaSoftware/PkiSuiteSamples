<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.lacunasoftware</groupId>
	<artifactId>pkisuite</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>sample</name>
	<description>Demo project for Spring Boot</description>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>1.5.18.RELEASE</version>
		<relativePath/>
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>1.8</java.version>
		<!-- The Signer client needs Jackson >= 2.9, newer than Spring Boot 1.5 manages (see build.gradle). -->
		<jackson.version>2.12.1</jackson.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>com.lowagie</groupId>
			<artifactId>itext</artifactId>
			<version>4.2.0</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.pkiexpress</groupId>
			<artifactId>pki-express</artifactId>
			<version>1.20.0</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.restpki</groupId>
			<artifactId>restpki-client</artifactId>
			<version>1.15.6</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.restpki</groupId>
			<artifactId>restpkicore-client</artifactId>
			<version>1.4.0</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.amplia</groupId>
			<artifactId>amplia-client</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.cloudhub</groupId>
			<artifactId>cloudhub-client</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.lacunasoftware.signer</groupId>
			<artifactId>signer-client</artifactId>
			<version>2.13.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.4</version>
		</dependency>

		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.11</version>
		</dependency>

		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.8.5</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<excludes>
						<!-- This self-test calls RestPkiService.extendArchivalSignature(), which no
						     released restpkicore-client has yet (it is only on the client's
						     feature/extendachive branch, commit 93e460c). Re-enable it once
						     restpkicore-client ships that method. The same exclusion is in build.gradle. -->
						<exclude>**/XmlDiplomaArchivalExtensionCoreSelfTestController.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
