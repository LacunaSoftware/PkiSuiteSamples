// Documentation only. This file is NOT loaded: the app reads appsettings.json (and
// appsettings.<ASPNETCORE_ENVIRONMENT>.json) next to this file. It lists every key the app
// reads, with placeholder values. The committed appsettings.json holds a TRIAL token that
// update-licenses.ps1 rotates; do not replace it in this repository.
// The PKI SDK license is a separate file, LacunaPkiLicense.config, loaded by Program.cs from
// the working directory (run `dotnet run` from this folder).
// Environment variable ASPNETCORE_ENVIRONMENT=Development (set in Properties/launchSettings.json)
// enables the Angular dev server and the developer error page.
{
  "Logging": {
    "LogLevel": {
      // Standard ASP.NET Core log levels.
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RestPki": {
    // Rest PKI (v1) API access token, read by Classes/Util.cs and HomeController.
    "AccessToken": "YOUR_REST_PKI_ACCESS_TOKEN",
    // Optional. Rest PKI URL for on-premises installs, with trailing '/'. Default: https://pki.rest/
    "Endpoint": "https://pki.rest/"
  },
  "RestPkiCore": {
    // Bound by Startup.cs but not used by any sample in this project yet.
    "ApiKey": "YOUR_REST_PKI_CORE_API_KEY",
    // Optional. Rest PKI Core URL, with trailing '/'. Default: https://core.pki.rest/
    "Endpoint": "https://core.pki.rest/"
  },
  "WebPki": {
    // Optional. Base64 Web PKI license, sent to the Angular app by GET /api/configuration. Not needed on localhost.
    "License": "YOUR_BASE64_WEB_PKI_LICENSE",
    // Sent to the Angular app but not used by it.
    "Endpoint": null
  },
  // Standard ASP.NET Core host filtering.
  "AllowedHosts": "*"
}
