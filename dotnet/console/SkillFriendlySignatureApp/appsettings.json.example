// Documentation only. This file is NOT loaded: the app reads appsettings.json next to the
// executable, then user secrets (`dotnet user-secrets set <key> <value>` in this folder), then
// environment variables, each overriding the one before. In an environment variable, write ':'
// as '__', for example Signer__ApiKey.
// Never pass these values as command-line flags: an agent that runs the app would see them.
{
  "Signer": {
    // Signer instance. DropSigner is Lacuna's cloud instance; the sandbox is
    // https://signer-lac.azurewebsites.net. An API key works only on the instance that issued it.
    "Endpoint": "https://www.dropsigner.com",
    // Signer API key of your organization (Integrations > Applications on Signer), in the form
    // "app name|key". Required by `list` and `sign`. No key is committed in this repository.
    "ApiKey": "YOUR_SIGNER_API_KEY"
  },
  "PkiSdk": {
    // Optional. Base64 PKI SDK license. Leave it empty to load LacunaPkiLicense.config from the
    // folder of the executable: the trial license that update-licenses.ps1 rotates.
    "License": ""
  }
}
