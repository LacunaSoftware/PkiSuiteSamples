@using PkiSuiteAspNetMvcSample.Models.Rest
@model SignatureInfoModel

<h2 class="ls-title">XML Diploma Signature with REST PKI</h2>

<p>Element <i>DadosDiploma</i> signed successfully!</p>

<h3>Actions:</h3>
<ul>
	<li><a href="/Download/File/@Model.File">Download the signed file</a></li>
	<li><a href="/XmlDiplomaSignatureRest/DadosRegistro?userfile=@Model.File">Continue: sign the <i>DadosRegistro</i> element</a></li>
</ul>
